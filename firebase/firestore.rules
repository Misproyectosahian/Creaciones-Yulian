rules_version = '2';

// Reglas de seguridad de Creaciones Yulian
//  - Cualquiera puede ver productos visibles, catálogos y ajustes de la tienda.
//  - Cada cliente solo ve SUS pedidos y SUS datos.
//  - Los pedidos solo los crea el servidor (Netlify Function) con precios reales.
//  - Solo la administradora (documento admins/{uid}) puede editar todo.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function optionalString(d, field, max) {
      return !(field in d) || (d[field] is string && d[field].size() <= max);
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'phone', 'email', 'province', 'canton', 'district', 'address', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 80
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 20
        && optionalString(d, 'email', 120)
        && optionalString(d, 'province', 40)
        && optionalString(d, 'canton', 60)
        && optionalString(d, 'district', 60)
        && optionalString(d, 'address', 400);
    }

    // ── Productos ──
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.minDeposit is number
        && request.resource.data.minDeposit >= 0
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    // ── Catálogos ──
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Ajustes públicos de la tienda (SINPE, WhatsApp, entregas...) ──
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Datos de clientes ──
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data);
      allow delete: if false;
    }

    // ── Pedidos ──
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Se crean únicamente desde el servidor (create-order), que valida precios.
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ── Administración ──
    match /admins/{uid} {
      // Se crean a mano desde la consola de Firebase.
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /adminDevices/{token} {
      allow read, write: if isAdmin();
    }

    // Contador de números de pedido (solo el servidor)
    match /counters/{docId} {
      allow read, write: if false;
    }
  }
}
