# Copiá este archivo como ".env" para probar en tu computadora,
# y poné estas mismas variables en Netlify (Site configuration → Environment variables).

# ── Firebase (Configuración del proyecto → Tus apps → App web) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Solo para probar en tu compu con los emuladores de Firebase (no lo pongas en Netlify)
# VITE_USE_EMULATORS=true

# ── Solo para las funciones del servidor (NO llevan VITE_, son secretas) ──
# Cuenta de servicio: Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pegá la clave completa, incluyendo -----BEGIN PRIVATE KEY----- y -----END PRIVATE KEY-----
FIREBASE_PRIVATE_KEY=

# Cloudinary (fotos de productos): Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
